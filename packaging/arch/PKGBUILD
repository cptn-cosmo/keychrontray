# Maintainer: cptn-cosmo <https://github.com/cptn-cosmo>
pkgname=keychrontray-git
_pkgname=keychrontray
pkgver=r1.0000000
pkgrel=1
pkgdesc="KDE Plasma tray app for Keychron keyboards: battery status and RGB lighting profiles with game auto-switching"
arch=('x86_64' 'aarch64')
url="https://github.com/cptn-cosmo/keychrontray"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'kstatusnotifieritem' 'knotifications' 'kconfig' 'hidapi' 'systemd-libs'
         'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'kcoreaddons' 'ninja' 'extra-cmake-modules')
optdepends=('upower: keyboard battery level over Bluetooth'
            'bluez: Bluetooth connection detection')
provides=("$_pkgname")
conflicts=("$_pkgname")
install=keychrontray.install
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cmake -S "$_pkgname" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKEYCHRONTRAY_UDEV_RULES_DIR=/usr/lib/udev/rules.d \
        -DBUILD_TESTING=ON
    cmake --build build
}

check() {
    # Unit tests and the offscreen settings-window smoke test; no keyboard needed.
    QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
